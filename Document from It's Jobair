        "import numpy as np\n",
        "\n",
        "# 1. Define ID parameters and Matrix A\n",
        "d1 = 1\n",
        "d2 = 7\n",
        "\n",
        "A = np.array([[d1 + 2, d2 + 1],\n",
        "              [2 * d1, d2 + 2]], dtype=float)\n",
        "\n",
        "print(\" Matrix A Analysis \")\n",
        "print(\"Matrix A:\\n\", A)\n",
        "print(\"Shape:\", A.shape)\n",
        "\n",
        "det_A = np.linalg.det(A)\n",
        "print(f\"Determinant: {det_A:.4f}\")\n",
        "print(\"Rank:\", np.linalg.matrix_rank(A))\n",
        "\n",
        "eig_vals_A, _ = np.linalg.eig(A)\n",
        "print(\"Eigenvalues:\", np.round(eig_vals_A, 4))\n",
        "\n",
        "if not np.isclose(det_A, 0):\n",
        "    inv_A = np.linalg.inv(A)\n",
        "    print(\"Inverse:\\n\", np.round(inv_A, 4))\n",
        "else:\n",
        "    print(\"Inverse: Does not exist (Singular Matrix)\")\n",
        "\n",
        "# 3. Value Change Experiment: Add +1 to element A[0, 0]\n",
        "B = np.copy(A)\n",
        "B[0, 0] += 1\n",
        "\n",
        "print(\"\\n Matrix B Analysis (Changed A[0,0] from 3 to 4)\")\n",
        "print(\"Matrix B:\\n\", B)\n",
        "print(\"Shape:\", B.shape)\n",
        "\n",
        "det_B = np.linalg.det(B)\n",
        "print(f\"Determinant: {det_B:.4f}\")\n",
        "print(\"Rank:\", np.linalg.matrix_rank(B))\n",
        "\n",
        "eig_vals_B, _ = np.linalg.eig(B)\n",
        "print(\"Eigenvalues:\", np.round(eig_vals_B, 4))\n",
        "\n",
        "if not np.isclose(det_B, 0):\n",
        "    inv_B = np.linalg.inv(B)\n",
        "    print(\"Inverse:\\n\", np.round(inv_B, 4))\n",
        "else:\n",
        "    print(\"Inverse: Does not exist (Singular Matrix)\")"
